page {
  --primary: #2c9678;
  --primary-dark: #237a60;
  --primary-light: #3db896;
  --primary-gradient: linear-gradient(135deg, #2c9678 0%, #3db896 100%);
  --bg: #f5f7fa;
  --card-bg: #ffffff;
  --text: #1a1a2e;
  --text-secondary: #6b7280;
  --text-tertiary: #9ca3af;
  --border: #e5e7eb;
  --border-light: #f0f2f5;
  --radius: 24rpx;
  --radius-sm: 16rpx;
  --radius-lg: 32rpx;
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  --shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  --danger: #dc2626;
  --danger-light: rgba(220, 38, 38, 0.08);
  --warning: #d97706;
  --warning-light: rgba(217, 119, 6, 0.08);
  --success: #059669;
  --success-light: rgba(5, 150, 105, 0.08);
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'PingFang SC', 'Helvetica Neue', sans-serif;
  background-color: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

page::after {
  content: '';
  display: block;
  height: env(safe-area-inset-bottom);
}

.container {
  padding: 24rpx 28rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.card {
  background: var(--card-bg);
  border-radius: var(--radius);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
  position: relative;
  overflow: hidden;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.card:active {
  transform: scale(0.99);
  box-shadow: var(--shadow-sm);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: var(--text);
  letter-spacing: 0.5rpx;
}

.btn-primary {
  background: var(--primary-gradient);
  color: #fff;
  border-radius: var(--radius);
  height: 100rpx;
  line-height: 100rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-top: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(44, 150, 120, 0.3);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
  letter-spacing: 2rpx;
}

.btn-primary:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 12rpx rgba(44, 150, 120, 0.2);
}

.form-item {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

.form-input {
  height: 88rpx;
  background: var(--bg);
  border-radius: var(--radius-sm);
  padding: 0 24rpx;
  font-size: 30rpx;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  transition: border-color 0.2s ease, background-color 0.2s ease;
  color: var(--text);
}

.form-input:focus {
  border-color: var(--primary);
  background: #fff;
}

.picker {
  height: 88rpx;
  line-height: 88rpx;
  background: var(--bg);
  border-radius: var(--radius-sm);
  padding: 0 24rpx;
  font-size: 30rpx;
  border: 2rpx solid transparent;
  transition: border-color 0.2s ease;
  color: var(--text);
}

.picker:active {
  border-color: var(--primary);
}

.text-right {
  text-align: right;
}

.text-center {
  text-align: center;
}

.mt-20 {
  margin-top: 20rpx;
}

.mb-20 {
  margin-bottom: 20rpx;
}

.flex {
  display: flex;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  background: var(--success-light);
  color: var(--primary);
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
  margin-right: 12rpx;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateX(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}
