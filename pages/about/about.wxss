.about-hero {
  text-align: center;
  padding: 56rpx 24rpx 44rpx;
  background: var(--primary-gradient);
  border-radius: var(--radius-lg);
  margin-bottom: 28rpx;
  position: relative;
  overflow: hidden;
}

.about-hero::before {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -20rpx;
  width: 180rpx;
  height: 180rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.app-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin: 0 auto 20rpx;
  backdrop-filter: blur(10px);
  position: relative;
  z-index: 1;
}

.app-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1rpx;
  position: relative;
  z-index: 1;
}

.app-version {
  display: inline-block;
  margin-top: 12rpx;
  padding: 4rpx 16rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 500;
  position: relative;
  z-index: 1;
}

.section-card {
  background: var(--card-bg);
  border-radius: var(--radius);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 4rpx solid var(--primary);
}

.section-content {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.8;
}

.bold {
  font-weight: 600;
  color: var(--text);
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.feature-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.feature-bullet {
  font-size: 28rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.feature-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.tech-tag {
  display: inline-block;
  padding: 10rpx 24rpx;
  background: var(--success-light);
  color: var(--primary);
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.btn-back {
  margin-top: 40rpx;
  text-align: center;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 30rpx;
  color: #fff;
  background: var(--primary-gradient);
  border-radius: var(--radius);
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(44, 150, 120, 0.3);
  transition: all 0.15s ease;
}

.btn-back:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 12rpx rgba(44, 150, 120, 0.2);
}

.disclaimer {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-tertiary);
  padding: 32rpx 48rpx 24rpx;
  line-height: 1.6;
}
