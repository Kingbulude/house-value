.about-hero {
  text-align: center;
  padding: 60rpx 20rpx 40rpx;
}

.app-icon {
  font-size: 96rpx;
  margin-bottom: 20rpx;
}

.app-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary);
}

.section-card {
  background: var(--card-bg);
  border-radius: var(--radius);
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 16rpx;
}

.section-content {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.8;
}

.bold {
  font-weight: 600;
  color: var(--text);
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.feature-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.feature-bullet {
  font-size: 28rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.feature-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tech-tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  background: rgba(44, 150, 120, 0.1);
  color: var(--primary);
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.btn-back {
  margin-top: 40rpx;
  text-align: center;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  color: #fff;
  background: var(--primary);
  border-radius: 12rpx;
  font-weight: 500;
}

.btn-back:active {
  background: var(--primary-dark);
}

.disclaimer {
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
  padding: 30rpx 40rpx 20rpx;
  line-height: 1.5;
}
