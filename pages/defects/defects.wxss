.page-header {
  text-align: center;
  padding: 32rpx 0 24rpx;
}

.header-title {
  font-size: 42rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.header-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.filter-bar {
  white-space: nowrap;
  padding: 16rpx 0 24rpx;
}

.filter-tab {
  display: inline-block;
  padding: 14rpx 32rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  background: var(--card-bg);
  box-shadow: var(--shadow-sm);
  font-weight: 500;
  transition: all 0.2s ease;
  border: 2rpx solid transparent;
}

.filter-tab.active {
  background: var(--primary-gradient);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(44, 150, 120, 0.25);
  border-color: transparent;
}

.filter-tab:active {
  transform: scale(0.95);
}

.defect-list {
  padding-bottom: 24rpx;
}

.defect-card {
  background: var(--card-bg);
  border-radius: var(--radius);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow);
  border-left: 6rpx solid var(--warning);
  transition: transform 0.15s ease;
}

.defect-card:active {
  transform: scale(0.98);
}

.defect-header {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.severity-icon {
  font-size: 36rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.defect-info {
  flex: 1;
  min-width: 0;
}

.defect-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 8rpx;
}

.defect-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.penalty-badge {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.penalty-badge.severe {
  background: var(--danger-light);
  color: var(--danger);
}

.penalty-badge.medium {
  background: var(--warning-light);
  color: var(--warning);
}

.communities-section {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-light);
}

.communities-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-bottom: 14rpx;
  font-weight: 500;
}

.community-tags {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.community-tag {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 18rpx;
  background: var(--bg);
  border-radius: var(--radius-sm);
}

.comm-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}

.comm-district {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.comm-level {
  margin-left: auto;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.comm-level.level-high {
  color: var(--danger);
  background: var(--danger-light);
}

.comm-level.level-medium {
  color: var(--warning);
  background: var(--warning-light);
}

.comm-level.level-low {
  color: var(--success);
  background: var(--success-light);
}

.disclaimer {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-tertiary);
  padding: 32rpx 48rpx 24rpx;
  line-height: 1.6;
}
