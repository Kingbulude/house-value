.empty-state {
  text-align: center;
  padding: 140rpx 48rpx 100rpx;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  margin: 0 auto 32rpx;
}

.empty-text {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: var(--text-tertiary);
  line-height: 1.6;
}

.history-list {
  padding-bottom: 30rpx;
}

.history-card {
  background: var(--card-bg);
  border-radius: var(--radius);
  margin-bottom: 20rpx;
  box-shadow: var(--shadow);
  overflow: hidden;
  border-left: 6rpx solid var(--primary);
  transition: transform 0.15s ease;
}

.history-card:active {
  transform: scale(0.98);
}

.card-main {
  padding: 28rpx 24rpx;
}

.card-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-community {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

.card-date {
  font-size: 22rpx;
  color: var(--text-tertiary);
  flex-shrink: 0;
  background: var(--bg);
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

.card-row {
  margin-bottom: 10rpx;
}

.card-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.meta-tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  background: var(--success-light);
  color: var(--primary);
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.card-value {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 18rpx;
  margin-bottom: 0;
}

.value-price {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary);
}

.value-unit {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.card-actions {
  display: flex;
  border-top: 1rpx solid var(--border-light);
}

.btn-view {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 600;
  transition: background 0.15s ease;
}

.btn-view:active {
  background: var(--success-light);
}

.btn-delete {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  font-size: 28rpx;
  color: var(--danger);
  font-weight: 600;
  border-left: 1rpx solid var(--border-light);
  transition: background 0.15s ease;
}

.btn-delete:active {
  background: var(--danger-light);
}

.clear-btn {
  margin-top: 40rpx;
  text-align: center;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 30rpx;
  color: var(--danger);
  background: var(--card-bg);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  font-weight: 500;
  transition: all 0.15s ease;
}

.clear-btn:active {
  background: var(--danger-light);
  transform: scale(0.98);
}
