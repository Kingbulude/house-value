.hero {
  text-align: center;
  padding: 60rpx 32rpx 48rpx;
  background: linear-gradient(135deg, #1a4a6e 0%, #2c9678 50%, #3db896 100%);
  border-radius: var(--radius-lg);
  margin-bottom: 28rpx;
  position: relative;
  overflow: hidden;
}

.hero::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -40rpx;
  width: 260rpx;
  height: 260rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 50%;
}

.hero::after {
  content: '';
  position: absolute;
  bottom: -80rpx;
  left: -30rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 50%;
}

.hero-city {
  display: inline-block;
  padding: 6rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
  margin-bottom: 20rpx;
  backdrop-filter: blur(10px);
  position: relative;
  z-index: 1;
}

.hero-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
  display: block;
  position: relative;
  z-index: 1;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
  letter-spacing: 3rpx;
  position: relative;
  z-index: 1;
  text-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.2);
}

.hero-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.6;
  position: relative;
  z-index: 1;
}

.hero-tip {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 16rpx;
  position: relative;
  z-index: 1;
}

.feature-list {
  margin: 0 0 32rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  background: var(--card-bg);
  border-radius: var(--radius);
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow);
  transition: transform 0.15s ease;
}

.feature-item:active {
  transform: scale(0.98);
}

.feature-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.feature-icon.green {
  background: var(--success-light);
}

.feature-icon.blue {
  background: rgba(59, 130, 246, 0.1);
}

.feature-icon.orange {
  background: var(--warning-light);
}

.feature-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
  color: var(--text);
}

.feature-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.cache-card {
  background: var(--card-bg);
  border-radius: var(--radius);
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-left: 6rpx solid var(--primary);
  transition: transform 0.15s ease;
}

.cache-card:active {
  transform: scale(0.98);
}

.cache-left {
  flex: 1;
  min-width: 0;
}

.cache-label {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-bottom: 6rpx;
  text-transform: uppercase;
  letter-spacing: 1rpx;
  font-weight: 500;
}

.cache-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cache-action {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 600;
  flex-shrink: 0;
  padding-left: 20rpx;
}

.nav-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--card-bg);
  border-radius: var(--radius);
  padding: 28rpx 16rpx;
  box-shadow: var(--shadow-sm);
  transition: transform 0.15s ease;
}

.nav-item:active {
  transform: scale(0.95);
}

.nav-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-bottom: 12rpx;
}

.nav-icon-wrap.bg-1 {
  background: var(--success-light);
}

.nav-icon-wrap.bg-2 {
  background: rgba(59, 130, 246, 0.1);
}

.nav-icon-wrap.bg-3 {
  background: rgba(168, 85, 247, 0.1);
}

.nav-label {
  font-size: 24rpx;
  color: var(--text);
  font-weight: 500;
}

.disclaimer {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 16rpx;
  padding: 0 24rpx;
  line-height: 1.6;
}
