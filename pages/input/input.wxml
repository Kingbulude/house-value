<view class="container">

  <view class="card">
    <view class="section-header" data-section="section1" bindtap="toggleSection">
      <text class="card-title" style="margin-bottom:0">&#x1F4CD; 区域信息</text>
      <text class="section-arrow">{{collapsedMap.section1 ? '&#x25B6;' : '&#x25BC;'}}</text>
    </view>
    <view class="section-body" hidden="{{collapsedMap.section1}}">
      <view class="form-item">
        <text class="form-label">所在区域</text>
        <picker mode="selector" range="{{districtList}}" value="{{districtIndex}}" bindchange="onDistrictChange">
          <view class="picker">{{district || '请选择区域'}}</view>
        </picker>
      </view>
      <view class="form-item">
        <text class="form-label">板块/商圈</text>
        <picker mode="selector" range="{{bdList}}" value="{{bdIndex}}" bindchange="onBdChange">
          <view class="picker {{bdList.length === 0 ? 'picker-disabled' : ''}}">{{businessDistrict || (bdList.length === 0 ? '该区域暂无板块数据' : '请选择板块/商圈')}}</view>
        </picker>
      </view>
      <view class="form-item">
        <text class="form-label">小区名称</text>
        <input class="form-input" value="{{communityName}}"
               data-field="communityName" bindinput="onInput" bindblur="onCommunityBlur"
               placeholder="如：万科西庐、绿城桂语江南" />
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-header" data-section="section2" bindtap="toggleSection">
      <text class="card-title" style="margin-bottom:0">&#x1F3E0; 房屋信息</text>
      <text class="section-arrow">{{collapsedMap.section2 ? '&#x25B6;' : '&#x25BC;'}}</text>
    </view>
    <view class="section-body" hidden="{{collapsedMap.section2}}">
      <view class="form-row">
        <view class="form-col">
          <text class="form-label">面积（㎡）</text>
          <input class="form-input" type="digit" value="{{area || ''}}"
                 data-field="area" bindinput="onNumberInput" placeholder="如：89" />
        </view>
        <view class="form-col">
          <text class="form-label">朝向</text>
          <picker mode="selector" range="{{orientationList}}" value="{{orientationIndex}}" bindchange="onOrientationChange">
            <view class="picker">{{orientation}}</view>
          </picker>
        </view>
      </view>
      <view class="form-row">
        <view class="form-col">
          <text class="form-label">所在楼层</text>
          <input class="form-input" type="number" value="{{floor || ''}}"
                 data-field="floor" bindinput="onNumberInput" placeholder="如：6" />
        </view>
        <view class="form-col">
          <text class="form-label">总楼层</text>
          <input class="form-input" type="number" value="{{totalFloors || ''}}"
                 data-field="totalFloors" bindinput="onNumberInput" placeholder="如：18" />
        </view>
      </view>
      <view class="form-row">
        <view class="form-col">
          <text class="form-label">装修</text>
          <picker mode="selector" range="{{decorationList}}" value="{{decorationIndex}}" bindchange="onDecorationChange">
            <view class="picker">{{decoration}}</view>
          </picker>
        </view>
        <view class="form-col">
          <text class="form-label">房龄（年）</text>
          <input class="form-input" type="number" value="{{buildingAge || ''}}"
                 data-field="buildingAge" bindinput="onNumberInput" placeholder="如：5" />
        </view>
      </view>
      <view class="form-row">
        <view class="form-col">
          <text class="form-label">电梯</text>
          <picker mode="selector" range="{{elevatorList}}" value="{{elevatorIndex}}" bindchange="onElevatorChange">
            <view class="picker">{{elevatorList[elevatorIndex]}}</view>
          </picker>
        </view>
        <view class="form-col">
          <text class="form-label">楼栋位置</text>
          <picker mode="selector" range="{{buildingPositionList}}" value="{{buildingPositionIndex}}" bindchange="onBuildingPositionChange">
            <view class="picker">{{buildingPositionList[buildingPositionIndex]}}</view>
          </picker>
        </view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-header" data-section="section3" bindtap="toggleSection">
      <text class="card-title" style="margin-bottom:0">&#x1F4B0; 价格数据</text>
      <text class="section-arrow">{{collapsedMap.section3 ? '&#x25B6;' : '&#x25BC;'}}</text>
    </view>
    <view class="section-body" hidden="{{collapsedMap.section3}}">
      <view class="form-row">
        <view class="form-col">
          <text class="form-label">同小区均价（元/㎡）</text>
          <input class="form-input" type="digit" value="{{marketPrice || ''}}"
                 data-field="marketPrice" bindinput="onNumberInput" placeholder="45000" />
        </view>
        <view class="form-col">
          <text class="form-label">同户型月租金（元/月）</text>
          <input class="form-input" type="digit" value="{{monthlyRent || ''}}"
                 data-field="monthlyRent" bindinput="onNumberInput" placeholder="5000" />
        </view>
      </view>
      <text class="hint-text">提示：至少填写一个均价或租金用于测算。两个都填效果更准确。</text>
    </view>
  </view>

  <view class="card">
    <view class="section-header" data-section="section4" bindtap="toggleSection">
      <text class="card-title" style="margin-bottom:0">&#x1F697; 停车位</text>
      <text class="section-arrow">{{collapsedMap.section4 ? '&#x25B6;' : '&#x25BC;'}}</text>
    </view>
    <view class="section-body" hidden="{{collapsedMap.section4}}">
      <view class="switch-row">
        <text class="form-label" style="margin-bottom:0">停车位</text>
        <switch checked="{{hasParkingSpace}}" data-field="hasParkingSpace" bindchange="onSwitchChange" color="#2c9678" />
      </view>
      <view hidden="{{!hasParkingSpace}}">
        <view class="form-row">
          <view class="form-col">
            <text class="form-label">车位类型</text>
            <picker mode="selector" range="{{parkingTypeList}}" value="{{parkingTypeIndex}}" bindchange="onParkingTypeChange">
              <view class="picker">{{parkingTypeIndex >= 0 ? parkingTypeList[parkingTypeIndex] : '请选择'}}</view>
            </picker>
          </view>
          <view class="form-col">
            <text class="form-label">车位价格/月租（元）</text>
            <input class="form-input" type="digit" value="{{parkingPrice || ''}}"
                   data-field="parkingPrice" bindinput="onNumberInput" placeholder="产权填总价，租赁填月租" />
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-header" data-section="section5" bindtap="toggleSection">
      <text class="card-title" style="margin-bottom:0">&#x1F4CA; 成本估算参数</text>
      <text class="section-arrow">{{collapsedMap.section5 ? '&#x25B6;' : '&#x25BC;'}}</text>
    </view>
    <view class="section-body" hidden="{{collapsedMap.section5}}">
      <view class="form-row">
        <view class="form-col">
          <text class="form-label">物业费（元/㎡/月）</text>
          <input class="form-input" type="digit" value="{{propertyFee || ''}}"
                 data-field="propertyFee" bindinput="onNumberInput" placeholder="2.5" />
        </view>
        <view class="form-col">
          <text class="form-label">持有年限</text>
          <input class="form-input" type="number" value="{{holdingYears || ''}}"
                 data-field="holdingYears" bindinput="onNumberInput" placeholder="5" />
        </view>
      </view>
      <view class="form-item">
        <text class="form-label">无风险收益参考（%）</text>
        <input class="form-input" type="digit" value="{{riskFreeRate || ''}}"
               data-field="riskFreeRate" bindinput="onNumberInput" placeholder="3.5" />
      </view>
      <text class="hint-text">参考：国债约2.5%，大额存条约3%，理财约3.5%。用于估算资金占用成本参考。</text>
    </view>
  </view>

  <view class="card">
    <view class="section-header" data-section="section6" bindtap="toggleSection">
      <text class="card-title" style="margin-bottom:0">&#x1F687; 交通配套</text>
      <text class="section-arrow">{{collapsedMap.section6 ? '&#x25B6;' : '&#x25BC;'}}</text>
    </view>
    <view class="section-body" hidden="{{collapsedMap.section6}}">
      <view class="form-row">
        <view class="form-col">
          <text class="form-label">最近地铁距离（米）</text>
          <input class="form-input" type="number" value="{{metroDistance || ''}}"
                 data-field="metroDistance" bindinput="onNumberInput" placeholder="500" />
        </view>
        <view class="form-col">
          <text class="form-label">地铁线路数</text>
          <input class="form-input" type="number" value="{{metroLines || ''}}"
                 data-field="metroLines" bindinput="onNumberInput" placeholder="1" />
        </view>
      </view>
      <view class="form-item">
        <text class="form-label">周边公交线路数</text>
        <input class="form-input" type="number" value="{{busRoutes || ''}}"
               data-field="busRoutes" bindinput="onNumberInput" placeholder="8" />
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-header" data-section="section7" bindtap="toggleSection">
      <text class="card-title" style="margin-bottom:0">&#x1F393; 教育配套</text>
      <text class="section-arrow">{{collapsedMap.section7 ? '&#x25B6;' : '&#x25BC;'}}</text>
    </view>
    <view class="section-body" hidden="{{collapsedMap.section7}}">
      <view class="form-row">
        <view class="form-col">
          <text class="form-label">幼儿园</text>
          <input class="form-input" value="{{kindergarten}}"
                 data-field="kindergarten" bindinput="onInput" placeholder="如：省府机关幼儿园" />
        </view>
        <view class="form-col">
          <text class="form-label">小学</text>
          <input class="form-input" value="{{primarySchool}}"
                 data-field="primarySchool" bindinput="onInput" placeholder="如：学军小学" />
        </view>
      </view>
      <view class="form-row">
        <view class="form-col">
          <text class="form-label">初中</text>
          <input class="form-input" value="{{middleSchool}}"
                 data-field="middleSchool" bindinput="onInput" placeholder="如：文澜中学" />
        </view>
        <view class="form-col">
          <text class="form-label">高中</text>
          <input class="form-input" value="{{highSchool}}"
                 data-field="highSchool" bindinput="onInput" placeholder="如：杭二中" />
        </view>
      </view>
      <text class="hint-text">提示：填写对口学校名称，系统会自动识别学校等级并计算学区溢价。不填则不加分。</text>
    </view>
  </view>

  <view class="card">
    <view class="section-header" data-section="section8" bindtap="toggleSection">
      <text class="card-title" style="margin-bottom:0">&#x1F6D2; 商业配套</text>
      <text class="section-arrow">{{collapsedMap.section8 ? '&#x25B6;' : '&#x25BC;'}}</text>
    </view>
    <view class="section-body" hidden="{{collapsedMap.section8}}">
      <view class="form-row">
        <view class="form-col">
          <text class="form-label">周边大型商场数</text>
          <input class="form-input" type="number" value="{{mallCount || ''}}"
                 data-field="mallCount" bindinput="onNumberInput" placeholder="1" />
        </view>
        <view class="form-col">
          <text class="form-label">周边餐饮数</text>
          <input class="form-input" type="number" value="{{restaurantCount || ''}}"
                 data-field="restaurantCount" bindinput="onNumberInput" placeholder="15" />
        </view>
      </view>
      <view class="switch-row">
        <text class="form-label" style="margin-bottom:0">有无菜市场</text>
        <switch checked="{{hasMarket}}" data-field="hasMarket" bindchange="onSwitchChange" color="#2c9678" />
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-header" data-section="section9" bindtap="toggleSection">
      <text class="card-title" style="margin-bottom:0">&#x1F3E5; 医疗配套</text>
      <text class="section-arrow">{{collapsedMap.section9 ? '&#x25B6;' : '&#x25BC;'}}</text>
    </view>
    <view class="section-body" hidden="{{collapsedMap.section9}}">
      <view class="switch-row">
        <text class="form-label" style="margin-bottom:0">三甲医院（3km内）</text>
        <switch checked="{{hasTier3Hospital}}" data-field="hasTier3Hospital" bindchange="onSwitchChange" color="#2c9678" />
      </view>
      <view class="form-item" hidden="{{!hasTier3Hospital}}">
        <text class="form-label">三甲医院距离（米）</text>
        <input class="form-input" type="number" value="{{hospitalDistance || ''}}"
               data-field="hospitalDistance" bindinput="onNumberInput" placeholder="2000" />
      </view>
      <view class="switch-row">
        <text class="form-label" style="margin-bottom:0">社区医院/诊所</text>
        <switch checked="{{hasCommunityHospital}}" data-field="hasCommunityHospital" bindchange="onSwitchChange" color="#2c9678" />
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-header" data-section="section10" bindtap="toggleSection">
      <text class="card-title" style="margin-bottom:0">&#x1F333; 自然环境</text>
      <text class="section-arrow">{{collapsedMap.section10 ? '&#x25B6;' : '&#x25BC;'}}</text>
    </view>
    <view class="section-body" hidden="{{collapsedMap.section10}}">
      <view class="switch-row">
        <text class="form-label" style="margin-bottom:0">公园/绿地</text>
        <switch checked="{{hasPark}}" data-field="hasPark" bindchange="onSwitchChange" color="#2c9678" />
      </view>
      <view class="form-item" hidden="{{!hasPark}}">
        <text class="form-label">公园距离（米）</text>
        <input class="form-input" type="number" value="{{parkDistance || ''}}"
               data-field="parkDistance" bindinput="onNumberInput" placeholder="500" />
      </view>
      <view class="switch-row">
        <text class="form-label" style="margin-bottom:0">河/湖景观</text>
        <switch checked="{{hasWater}}" data-field="hasWater" bindchange="onSwitchChange" color="#2c9678" />
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-header" data-section="section11" bindtap="toggleSection">
      <text class="card-title" style="margin-bottom:0">&#x26A0;&#xFE0F; 硬伤因素</text>
      <text class="section-arrow">{{collapsedMap.section11 ? '&#x25B6;' : '&#x25BC;'}}</text>
    </view>
    <view class="section-body" hidden="{{collapsedMap.section11}}">
      <view class="defect-grid">
        <view class="defect-item {{defectFlags[item.key] ? 'active' : ''}}"
              wx:for="{{defectOptions}}" wx:key="key"
              data-key="{{item.key}}" bindtap="onDefectToggle">
          <view class="defect-check">{{defectFlags[item.key] ? '✓' : ''}}</view>
          <text class="defect-text">{{item.label}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="btn-primary" bindtap="submit">开始测算分析</view>
  <view class="safe-bottom"></view>
</view>
