.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 48rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.section-badge {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #e8edf2;
  color: #94a3b8;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.badge-filled {
  background: rgba(44, 150, 120, 0.12);
  color: var(--primary);
}

.badge-warn {
  background: rgba(234, 88, 12, 0.1);
  color: #ea580c;
}

.section-arrow {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.section-body {
  padding-top: 20rpx;
}

.card-filled {
  border-left: 4rpx solid var(--primary);
}

.form-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.form-col {
  flex: 1;
  min-width: 0;
}

.switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.picker-disabled {
  color: #bbb;
}

.input-prefix-wrap {
  position: relative;
  display: flex;
  align-items: center;
}

.input-prefix {
  position: absolute;
  left: 20rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--primary);
  z-index: 1;
  pointer-events: none;
}

.input-with-prefix {
  padding-left: 48rpx !important;
}

.input-with-loading {
  position: relative;
}

.community-loading {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid var(--border);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.6s linear infinite;
}

@keyframes spin {
  to { transform: translateY(-50%) rotate(360deg); }
}

.placeholder-light {
  color: #c0c8d4;
}

.defect-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.defect-item {
  width: calc(50% - 8rpx);
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #f8f9fa;
  border-radius: 10rpx;
  border: 2rpx solid var(--border);
  box-sizing: border-box;
}

.defect-item.active {
  background: rgba(44, 150, 120, 0.1);
  border-color: var(--primary);
}

.defect-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 6rpx;
  border: 2rpx solid #ccc;
  margin-right: 12rpx;
  text-align: center;
  line-height: 36rpx;
  font-size: 24rpx;
  color: var(--primary);
  flex-shrink: 0;
}

.defect-item.active .defect-check {
  background: var(--primary);
  border-color: var(--primary);
  color: #fff;
}

.defect-text {
  font-size: 26rpx;
  color: var(--text);
}

.hint-text {
  font-size: 24rpx;
  color: #94a3b8;
  margin-top: -12rpx;
  margin-bottom: 16rpx;
}

.btn-quick-fill {
  background: var(--card-bg);
  color: var(--primary);
  border: 2rpx solid var(--primary);
  border-radius: 12rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  margin-top: 24rpx;
}

.btn-quick-fill:active {
  background: rgba(44, 150, 120, 0.06);
}

.btn-submit {
  background: var(--primary);
  color: #fff;
  border-radius: 12rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  margin-top: 16rpx;
  transition: opacity 0.2s;
}

.btn-submit:active {
  background: var(--primary-dark);
}

.btn-disabled {
  background: #c8d0d8;
  color: #fff;
  pointer-events: none;
}

.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid var(--border);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin-full 0.7s linear infinite;
}

@keyframes spin-full {
  to { transform: rotate(360deg); }
}

.safe-bottom {
  height: 60rpx;
  padding-bottom: env(safe-area-inset-bottom);
}
