.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 48rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.section-badge {
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  background: var(--bg);
  color: var(--text-tertiary);
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.badge-filled {
  background: var(--primary-gradient);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(44, 150, 120, 0.25);
}

.badge-warn {
  background: linear-gradient(135deg, #ea580c, #f97316);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(234, 88, 12, 0.25);
}

.section-arrow {
  font-size: 20rpx;
  color: var(--text-tertiary);
  transition: transform 0.2s ease;
}

.section-body {
  padding-top: 24rpx;
}

.card-filled {
  border-left: 6rpx solid var(--primary);
}

.form-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.form-col {
  flex: 1;
  min-width: 0;
}

.switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 8rpx 0;
}

.picker-disabled {
  color: var(--text-tertiary);
}

.input-prefix-wrap {
  position: relative;
  display: flex;
  align-items: center;
}

.input-prefix {
  position: absolute;
  left: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--primary);
  z-index: 1;
  pointer-events: none;
}

.input-with-prefix {
  padding-left: 52rpx !important;
}

.input-with-loading {
  position: relative;
}

.community-loading {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid var(--border);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.6s linear infinite;
}

@keyframes spin {
  to { transform: translateY(-50%) rotate(360deg); }
}

.placeholder-light {
  color: #c0c8d4;
}

.defect-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.defect-item {
  width: calc(50% - 8rpx);
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: var(--bg);
  border-radius: var(--radius-sm);
  border: 2rpx solid transparent;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.defect-item.active {
  background: var(--success-light);
  border-color: var(--primary);
}

.defect-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  border: 2rpx solid var(--border);
  margin-right: 14rpx;
  text-align: center;
  line-height: 40rpx;
  font-size: 24rpx;
  color: var(--primary);
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.defect-item.active .defect-check {
  background: var(--primary-gradient);
  border-color: var(--primary);
  color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(44, 150, 120, 0.3);
}

.defect-text {
  font-size: 26rpx;
  color: var(--text);
  font-weight: 500;
}

.hint-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-top: -12rpx;
  margin-bottom: 20rpx;
  padding-left: 4rpx;
}

.btn-quick-fill {
  background: var(--card-bg);
  color: var(--primary);
  border: 2rpx solid var(--primary);
  border-radius: var(--radius);
  height: 92rpx;
  line-height: 92rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  margin-top: 28rpx;
  transition: all 0.15s ease;
}

.btn-quick-fill:active {
  background: var(--success-light);
  transform: scale(0.98);
}

.btn-submit {
  background: var(--primary-gradient);
  color: #fff;
  border-radius: var(--radius);
  height: 100rpx;
  line-height: 100rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-top: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(44, 150, 120, 0.3);
  transition: all 0.15s ease;
  letter-spacing: 2rpx;
}

.btn-submit:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 12rpx rgba(44, 150, 120, 0.2);
}

.btn-disabled {
  background: linear-gradient(135deg, #c8d0d8, #d1d9e6);
  color: #fff;
  pointer-events: none;
  box-shadow: none;
}

.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  backdrop-filter: blur(4px);
}

.loading-spinner {
  width: 72rpx;
  height: 72rpx;
  border: 6rpx solid var(--border);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin-full 0.7s linear infinite;
}

@keyframes spin-full {
  to { transform: rotate(360deg); }
}

.safe-bottom {
  height: 60rpx;
  padding-bottom: env(safe-area-inset-bottom);
}
