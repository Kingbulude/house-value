<view class="container" wx:if="{{loaded && result && input}}">

  <!-- Header -->
  <view class="result-header">
    <view class="result-community">{{input.communityName || '未填写小区'}}</view>
    <view class="result-meta">
      <text class="tag">{{input.district}}</text>
      <text class="tag" wx:if="{{input.businessDistrict}}">{{input.businessDistrict}}</text>
      <text class="tag">{{input.area}}m²</text>
    </view>
  </view>

  <!-- Highlight Card -->
  <view class="card highlight">
    <view class="highlight-label">综合参考价</view>
    <view class="highlight-price">{{result.finalValuationText}}</view>
    <view class="highlight-unit">{{result.unitPrice}} 元/㎡</view>
    <view class="highlight-range">参考区间：{{result.lowerBoundText}} ~ {{result.upperBoundText}}</view>
    <view class="confidence-badge {{result.confidenceClass}}">参考度 {{result.confidence}}%</view>

    <view class="highlight-actions">
      <view class="hl-action-btn" bindtap="copyResult">
        <text class="hl-action-icon">📋</text>
        <text class="hl-action-text">复制结果</text>
      </view>
      <view class="hl-action-btn" bindtap="sharePoster">
        <text class="hl-action-icon">📊</text>
        <text class="hl-action-text">分享</text>
      </view>
    </view>
  </view>

  <!-- Tab Bar -->
  <scroll-view scroll-x class="tab-bar">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab-item {{activeTab === item.key ? 'active' : ''}}"
      data-tab="{{item.key}}"
      bindtap="switchTab"
    >{{item.label}}</view>
  </scroll-view>

  <!-- Summary Tab -->
  <view class="card tab-panel" wx:if="{{activeTab === 'summary'}}">
    <view class="card-title">分析概要</view>
    <view class="info-row">
      <text class="info-label">小区名称</text>
      <text class="info-value">{{input.communityName || '未填写'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">所在区域</text>
      <text class="info-value">{{input.district}}{{input.businessDistrict ? ' · ' + input.businessDistrict : ''}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">区位等级</text>
      <text class="info-value">{{result.factors.location.level}}级 — {{result.factors.location.detail}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">房屋信息</text>
      <text class="info-value">{{input.area}}㎡ / {{input.floor || '?'}}/{{input.totalFloors || '?'}}层 / {{input.orientation}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">装修/房龄</text>
      <text class="info-value">{{input.decoration}} / {{input.buildingAge || '?'}}年{{input.hasElevator ? ' / 有电梯' : ' / 无电梯'}}</text>
    </view>
    <view class="info-row" wx:if="{{result.marketAnchor}}">
      <text class="info-label">价格锚定</text>
      <text class="info-value">{{result.marketAnchor}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">配套总分</text>
      <text class="info-value">{{result.factors.amenities.total}}/80</text>
    </view>
    <view class="info-row">
      <text class="info-label">硬伤扣分</text>
      <text class="info-value {{result.factors.defects.defects.length > 0 ? 'negative' : ''}}">{{result.factors.defects.defects.length > 0 ? result.factors.defects.defects.length + '项 (累计-' + defectsTotalPenalty + '%)' : '无'}}</text>
    </view>
    <view class="summary-action" wx:if="{{result.factors.defects.defects.length > 0}}" bindtap="viewDefects">
      <text>查看硬伤详情 →</text>
    </view>
  </view>

  <!-- Methods Tab -->
  <view class="card tab-panel" wx:if="{{activeTab === 'methods'}}">
    <view class="card-title">三把尺子交叉验证</view>

    <view class="weight-bar">
      <view class="weight-segment weight-market" style="flex:{{result.marketWeight || 0}}">
        <text class="weight-seg-text" wx:if="{{result.marketWeight >= 15}}">{{result.marketWeight}}%</text>
      </view>
      <view class="weight-segment weight-income" style="flex:{{result.incomeWeight || 0}}">
        <text class="weight-seg-text" wx:if="{{result.incomeWeight >= 15}}">{{result.incomeWeight}}%</text>
      </view>
      <view class="weight-segment weight-cost" style="flex:{{result.costWeight || 0}}">
        <text class="weight-seg-text" wx:if="{{result.costWeight >= 15}}">{{result.costWeight}}%</text>
      </view>
    </view>
    <view class="weight-legend">
      <view class="legend-item"><view class="legend-dot dot-market"></view>市场比较</view>
      <view class="legend-item"><view class="legend-dot dot-income"></view>收益还原</view>
      <view class="legend-item"><view class="legend-dot dot-cost"></view>成本法</view>
    </view>

    <view class="method-card" wx:if="{{result.methods.market}}">
      <view class="method-name">市场比较法</view>
      <view class="method-value">{{result.marketText}}</view>
      <view class="method-weight">权重 {{result.marketWeight}}% · 锚定: {{result.marketAnchor || '-'}}</view>
    </view>
    <view class="method-card" wx:if="{{result.methods.income}}">
      <view class="method-name">收益还原法</view>
      <view class="method-value">{{result.incomeText}}</view>
      <view class="method-weight">权重 {{result.incomeWeight}}% · CapRate {{result.capRateText}}</view>
    </view>
    <view class="method-card" wx:if="{{result.methods.cost}}">
      <view class="method-name">成本法</view>
      <view class="method-value">{{result.costText}}</view>
      <view class="method-weight">权重 {{result.costWeight}}%</view>
    </view>
    <view class="method-notes">
      <view wx:if="{{result.marketAnchor === '同小区均价'}}">
        <view class="note-item"><text class="note-bold">市场比较法：</text>以同小区均价为锚，仅做楼栋级修正（面积/朝向/楼层/装修/房龄/电梯/位置/硬伤），不重复叠加区位/配套/学区溢价。</view>
      </view>
      <view wx:if="{{result.marketAnchor === '板块基准价'}}">
        <view class="note-item"><text class="note-bold">市场比较法：</text>未提供小区均价，以板块基准价为锚，叠加区位/学区/市场情绪估算。</view>
      </view>
      <view class="note-item"><text class="note-bold">收益还原法：</text>年租金 ÷ 资本化率。资本化率根据区域等级取值（核心区3.5%，普通区4.5%，郊区5.5%）。</view>
      <view class="note-item"><text class="note-bold">成本法：</text>土地成本 + 建筑成本折旧。适用于新房和次新房。</view>
      <view class="note-item" wx:if="{{result.factors.liquidityDiscount > 0}}">
        <text class="note-bold">流动性折价：</text>大户型/高总价流动性较差，折价 {{result.liquidityDiscountText}}。
      </view>
    </view>
  </view>

  <!-- Amenities Tab -->
  <view class="card tab-panel" wx:if="{{activeTab === 'amenities'}}">
    <view class="card-title">配套评分</view>
    <view wx:for="{{amenitiesList}}" wx:key="name" class="amenity-dim">
      <view class="amenity-header">
        <text class="amenity-name">{{item.name}}</text>
        <text class="amenity-score" style="color:{{item.color}};">{{item.score}}/{{item.max}}</text>
      </view>
      <view class="score-bar">
        <view class="score-bar-fill" style="width:{{item.percent}}%;background:{{item.color}};"></view>
      </view>
      <view class="amenity-detail" wx:if="{{item.detailText}}">{{item.detailText}}</view>
    </view>
    <view class="amenity-total">
      <view class="amenity-total-row">
        <text class="amenity-total-label">配套总分</text>
        <text class="amenity-total-value">{{result.factors.amenities.total}}/80</text>
      </view>
      <view class="amenity-note">配套评分仅作参考展示，不再直接影响价格（已包含在小区均价中）</view>
    </view>
  </view>

  <!-- Defects Tab -->
  <view class="card tab-panel" wx:if="{{activeTab === 'defects'}}">
    <view class="card-title">硬伤检测</view>

    <view class="defects-severity-bar" wx:if="{{result.factors.defects.defects.length > 0}}">
      <view class="severity-badge severe-badge" wx:if="{{severeCount > 0}}">{{severeCount}}项严重</view>
      <view class="severity-badge moderate-badge" wx:if="{{moderateCount > 0}}">{{moderateCount}}项中等</view>
      <view class="severity-badge penalty-badge">累计折扣 {{defectsTotalPenalty}}%</view>
    </view>

    <view wx:if="{{result.factors.defects.defects.length === 0}}" class="defects-clean">
      未检测到明显硬伤
    </view>
    <view wx:for="{{defectsList}}" wx:key="name" class="defect-item">
      <view class="defect-icon {{item.isSevere ? 'severe' : 'warning'}}">{{item.isSevere ? '!' : '⚠'}}</view>
      <view class="defect-content">
        <view class="defect-title">{{item.name}} <text class="defect-penalty">-{{item.penaltyPercent}}%</text></view>
        <view class="defect-desc">{{item.desc}}</view>
      </view>
    </view>
    <view class="defects-summary" wx:if="{{result.factors.defects.defects.length > 0}}">
      <view class="info-row">
        <text class="info-label">综合硬伤系数</text>
        <text class="info-value negative">×{{result.factors.defects.coefficient}}</text>
      </view>
    </view>
  </view>

  <!-- Holding Cost Tab -->
  <view class="card tab-panel" wx:if="{{activeTab === 'holdingcost'}}">
    <view class="card-title">成本估算</view>
    <view class="hc-highlight">
      <view class="hc-highlight-title">年持有费用估算</view>
      <view class="hc-highlight-body">
        约 <text class="hc-highlight-value">{{result.holdingCost.annualCostText}}</text> / 年（月均 {{result.holdingCost.monthlyEquivalent}} 元）
        <view class="hc-highlight-note">仅供参考，未考虑房产增值收益</view>
      </view>
    </view>

    <view class="hc-breakdown">
      <view class="hc-breakdown-title">年度费用构成</view>
      <view class="hc-bar-track">
        <view
          wx:for="{{holdingCostBreakdown}}"
          wx:key="name"
          class="hc-bar-segment"
          style="flex:{{item.percent}};background:{{item.color}};"
        ></view>
      </view>
      <view class="hc-breakdown-legend">
        <view wx:for="{{holdingCostBreakdown}}" wx:key="name" class="hc-legend-item">
          <view class="hc-legend-dot" style="background:{{item.color}};"></view>
          <text class="hc-legend-name">{{item.name}}</text>
          <text class="hc-legend-val">{{item.value}}元 ({{item.percent}}%)</text>
        </view>
      </view>
    </view>

    <view class="hc-divider"></view>
    <view class="info-row">
      <text class="info-label">年持有费用</text>
      <text class="info-value negative">{{result.holdingCost.annualCostText}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">资金占用参考成本</text>
      <text class="info-value">{{result.holdingCost.annualBreakdown.opportunityCost}}元</text>
    </view>
    <view class="info-row">
      <text class="info-label">房屋折旧</text>
      <text class="info-value">{{result.holdingCost.annualBreakdown.buildingDepreciation}}元</text>
    </view>
    <view class="info-row">
      <text class="info-label">物业费</text>
      <text class="info-value">{{result.holdingCost.annualBreakdown.propertyFee}}元</text>
    </view>
    <view class="info-row" wx:if="{{result.holdingCost.annualBreakdown.parkingCost > 0}}">
      <text class="info-label">车位费用</text>
      <text class="info-value">{{result.holdingCost.annualBreakdown.parkingCost}}元</text>
    </view>
    <view class="hc-divider"></view>
    <view class="info-row">
      <text class="info-label bold">{{result.holdingCost.parameters.holdingYears}}年总费用</text>
      <text class="info-value negative bold">{{result.holdingCost.totalCostText}}</text>
    </view>
    <view class="hc-notes">
      <view>· 资金占用参考成本：房产总价 × 无风险收益参考</view>
      <view>· 房屋折旧：按每年2%估算</view>
      <view>· 本估算仅供参考，不构成投资建议</view>
    </view>
  </view>

  <!-- Factors Tab -->
  <view class="card tab-panel" wx:if="{{activeTab === 'factors'}}">
    <view class="card-title">系数明细</view>

    <view class="factor-section-title">价格锚定</view>
    <view class="info-row">
      <text class="info-label">价格锚定</text>
      <text class="info-value">{{result.marketAnchor || '未知'}}</text>
    </view>
    <view class="info-row" wx:if="{{result.factors.marketComparison && result.factors.marketComparison.anchorPrice}}">
      <text class="info-label">锚定均价</text>
      <text class="info-value">{{result.factors.marketComparison.anchorPrice}} 元/㎡</text>
    </view>

    <view class="factor-divider"></view>

    <view class="factor-section-title">楼栋级修正系数</view>
    <view class="info-row" wx:for="{{modifiersList}}" wx:key="label">
      <text class="info-label">{{item.label}}</text>
      <view class="mod-value-wrap">
        <view class="mod-dot {{item.modClass}}"></view>
        <text class="info-value {{item.modClass}}">×{{item.value}}</text>
      </view>
    </view>
    <view class="info-row factor-total">
      <text class="info-label bold">楼栋修正合计</text>
      <text class="info-value bold">×{{result.factors.buildingModifiers.total}}</text>
    </view>

    <block wx:if="{{result.factors.marketComparison && result.factors.marketComparison.locationCoefficient}}">
      <view class="factor-divider"></view>
      <view class="factor-section-title">板块估算系数（无小区均价时使用）</view>
      <view class="info-row">
        <text class="info-label">区位系数</text>
        <view class="mod-value-wrap">
          <view class="mod-dot {{result.factors.marketComparison.locationCoefficient > 1 ? 'positive' : 'negative'}}"></view>
          <text class="info-value {{result.factors.marketComparison.locationCoefficient > 1 ? 'positive' : 'negative'}}">×{{result.factors.marketComparison.locationCoefficient}}</text>
        </view>
      </view>
      <view class="info-row">
        <text class="info-label">学区溢价</text>
        <text class="info-value positive">+{{result.factors.marketComparison.schoolPremPercent}}%</text>
      </view>
      <view class="info-row" wx:if="{{result.factors.marketComparison.marketSentiment}}">
        <text class="info-label">市场情绪</text>
        <view class="mod-value-wrap">
          <view class="mod-dot {{result.factors.marketComparison.marketSentiment > 1 ? 'positive' : result.factors.marketComparison.marketSentiment < 1 ? 'negative' : 'neutral'}}"></view>
          <text class="info-value {{result.factors.marketComparison.marketSentiment > 1 ? 'positive' : result.factors.marketComparison.marketSentiment < 1 ? 'negative' : 'neutral'}}">×{{result.factors.marketComparison.marketSentiment}}</text>
        </view>
      </view>
    </block>

    <block wx:if="{{result.factors.incomeApproach}}">
      <view class="factor-divider"></view>
      <view class="factor-section-title">收益还原法参数</view>
      <view class="info-row">
        <text class="info-label">年租金（扣除3%空置）</text>
        <text class="info-value">{{result.factors.incomeApproach.annualRent}}元</text>
      </view>
      <view class="info-row">
        <text class="info-label">资本化率</text>
        <text class="info-value">{{result.factors.incomeApproach.capRatePercent}}</text>
      </view>
    </block>

    <view class="factor-divider"></view>

    <view class="info-row">
      <text class="info-label">流动性折价</text>
      <text class="info-value {{result.factors.liquidityDiscount > 0 ? 'negative' : 'neutral'}}">-{{result.factors.liquidityDiscountText}}%</text>
    </view>
  </view>

  <!-- Disclaimer -->
  <view class="disclaimer">
    <view class="disclaimer-title">免责声明</view>
    以上结果基于用户输入数据和内置规则引擎测算，仅为个人参考使用，不构成任何投资建议、房产评估报告或交易依据。实际房价受市场供需、政策调控、宏观经济等多种因素影响，请以实际交易价格和专业机构评估为准。
  </view>

  <!-- Action Buttons -->
  <view class="action-row">
    <view class="btn-secondary" bindtap="goBack">返回首页</view>
    <view class="btn-secondary primary" bindtap="reInput">修改信息</view>
  </view>

  <view class="safe-bottom"></view>

  <!-- Back to Top -->
  <view class="back-top {{showBackTop ? 'visible' : ''}}" bindtap="scrollToTop">
    <text class="back-top-icon">↑</text>
    <text class="back-top-text">顶部</text>
  </view>
</view>
