.result-header {
  text-align: center;
  padding: 20rpx 0 10rpx;
}

.result-community {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

.result-meta {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

/* Highlight Card */
.highlight {
  text-align: center;
  padding: 56rpx 32rpx 36rpx;
  background: linear-gradient(180deg, var(--success-light) 0%, var(--card-bg) 100%);
}

.highlight-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.highlight-price {
  font-size: 80rpx;
  font-weight: 700;
  color: var(--primary);
  line-height: 1.2;
  letter-spacing: 2rpx;
}

.highlight-unit {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 10rpx;
}

.highlight-range {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-top: 12rpx;
}

/* Highlight Actions */
.highlight-actions {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-top: 32rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid var(--border-light);
}

.hl-action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 32rpx;
  border-radius: 32rpx;
  background: var(--bg);
  transition: all 0.15s ease;
}

.hl-action-btn:active {
  background: var(--border-light);
  transform: scale(0.95);
}

.hl-action-icon {
  font-size: 28rpx;
}

.hl-action-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

/* Confidence Badge */
.confidence-badge {
  display: inline-block;
  margin-top: 20rpx;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.confidence-high {
  background: var(--success-light);
  color: #059669;
}

.confidence-medium {
  background: var(--warning-light);
  color: #d97706;
}

.confidence-low {
  background: var(--danger-light);
  color: #dc2626;
}

/* Tab Bar */
.tab-bar {
  white-space: nowrap;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}

.tab-item {
  display: inline-block;
  padding: 20rpx 28rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  border-radius: 24rpx;
  margin-right: 12rpx;
  background: var(--card-bg);
  transition: all 0.2s ease;
  font-weight: 500;
}

.tab-item.active {
  color: #fff;
  background: var(--primary-gradient);
  box-shadow: 0 4rpx 16rpx rgba(44, 150, 120, 0.25);
  font-weight: 600;
}

/* Tab Panel */
.tab-panel {
  animation: fadeIn 0.25s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* Info Rows */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--border-light);
  font-size: 28rpx;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  color: var(--text-secondary);
  flex-shrink: 0;
  font-weight: 400;
}

.info-value {
  color: var(--text);
  text-align: right;
  margin-left: 20rpx;
  font-weight: 500;
}

.info-value.negative {
  color: var(--danger);
}

.info-value.positive {
  color: var(--success);
}

.info-value.neutral {
  color: var(--text);
}

.info-label.bold,
.info-value.bold {
  font-weight: 600;
  font-size: 30rpx;
}

/* Summary tab action link */
.summary-action {
  text-align: center;
  padding: 20rpx 0 8rpx;
  color: var(--primary);
  font-size: 26rpx;
  font-weight: 600;
}

/* Method Cards */
.method-card {
  background: var(--bg);
  border-radius: var(--radius);
  padding: 28rpx;
  margin-bottom: 16rpx;
  border-left: 6rpx solid var(--primary);
}

.method-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.method-value {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--primary);
  margin: 12rpx 0;
}

.method-weight {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.method-notes {
  margin-top: 24rpx;
  padding: 24rpx;
  background: var(--bg);
  border-radius: var(--radius);
}

.note-item {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.8;
  margin-bottom: 10rpx;
}

.note-bold {
  font-weight: 600;
  color: var(--text);
}

/* Weight comparison bar */
.weight-bar {
  display: flex;
  height: 32rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.weight-segment {
  display: flex;
  align-items: center;
  justify-content: center;
  transition: flex 0.3s ease;
  min-width: 0;
  overflow: hidden;
}

.weight-segment:empty,
.weight-segment[style*="flex:0"],
.weight-segment[style*="flex: 0"] {
  display: none;
}

.weight-seg-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
  white-space: nowrap;
}

.weight-market {
  background: linear-gradient(135deg, #3b82f6, #60a5fa);
}

.weight-income {
  background: linear-gradient(135deg, #10b981, #34d399);
}

.weight-cost {
  background: linear-gradient(135deg, #f59e0b, #fbbf24);
}

.weight-legend {
  display: flex;
  justify-content: center;
  gap: 28rpx;
  margin-bottom: 28rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.dot-market { background: #3b82f6; }
.dot-income { background: #10b981; }
.dot-cost { background: #f59e0b; }

/* Amenities */
.amenity-dim {
  margin-bottom: 28rpx;
}

.amenity-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.amenity-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.amenity-score {
  font-size: 28rpx;
  font-weight: 700;
}

.score-bar {
  height: 20rpx;
  background: var(--bg);
  border-radius: 10rpx;
  overflow: hidden;
}

.score-bar-fill {
  height: 100%;
  border-radius: 10rpx;
  transition: width 0.4s ease;
  background: var(--primary-gradient);
}

.amenity-detail {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
  line-height: 1.6;
}

.amenity-total {
  border-top: 2rpx solid var(--border-light);
  padding-top: 20rpx;
  margin-top: 12rpx;
}

.amenity-total-row {
  display: flex;
  justify-content: space-between;
  font-size: 30rpx;
  font-weight: 700;
}

.amenity-total-label {
  color: var(--text);
}

.amenity-total-value {
  color: var(--primary);
}

.amenity-note {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 10rpx;
}

/* Defects */
.defects-severity-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}

.severity-badge {
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.severe-badge {
  background: var(--danger-light);
  color: var(--danger);
}

.moderate-badge {
  background: var(--warning-light);
  color: var(--warning);
}

.penalty-badge {
  background: rgba(107, 114, 128, 0.1);
  color: #6b7280;
}

.defects-clean {
  text-align: center;
  padding: 48rpx 0;
  color: var(--success);
  font-size: 30rpx;
  font-weight: 500;
}

.defect-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}

.defect-item:last-child {
  border-bottom: none;
}

.defect-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.defect-icon.severe {
  background: linear-gradient(135deg, #dc2626, #ef4444);
}

.defect-icon.warning {
  background: linear-gradient(135deg, #d97706, #f59e0b);
}

.defect-content {
  flex: 1;
}

.defect-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.defect-penalty {
  color: var(--danger);
  font-size: 24rpx;
  font-weight: 600;
}

.defect-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  line-height: 1.6;
}

.defects-summary {
  border-top: 2rpx solid var(--border-light);
  margin-top: 16rpx;
  padding-top: 16rpx;
}

/* Holding Cost */
.hc-highlight {
  background: linear-gradient(135deg, #f0f9ff, #e0f2fe);
  border: 1rpx solid #bae6fd;
  border-radius: var(--radius);
  padding: 28rpx;
  margin-bottom: 28rpx;
}

.hc-highlight-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0c4a6e;
  margin-bottom: 10rpx;
}

.hc-highlight-body {
  color: #075985;
  font-size: 28rpx;
  line-height: 1.7;
}

.hc-highlight-value {
  font-weight: 700;
  color: var(--primary);
  font-size: 32rpx;
}

.hc-highlight-note {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 6rpx;
}

/* Holding cost visual breakdown */
.hc-breakdown {
  margin-bottom: 28rpx;
}

.hc-breakdown-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 16rpx;
}

.hc-bar-track {
  display: flex;
  height: 24rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.hc-bar-segment {
  transition: flex 0.3s ease;
  min-width: 4rpx;
}

.hc-breakdown-legend {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.hc-legend-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
}

.hc-legend-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.hc-legend-name {
  color: var(--text-secondary);
  flex: 1;
}

.hc-legend-val {
  color: var(--text);
  font-weight: 600;
}

.hc-divider {
  border-top: 1rpx solid var(--border-light);
  margin: 20rpx 0;
}

.hc-notes {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.8;
}

/* Factors */
.factor-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 12rpx;
  margin-top: 12rpx;
  padding-left: 12rpx;
  border-left: 4rpx solid var(--primary);
}

.factor-divider {
  border-top: 1rpx solid var(--border-light);
  margin: 20rpx 0;
}

.factor-total {
  border-top: 2rpx solid var(--border);
  padding-top: 20rpx;
  margin-top: 12rpx;
}

/* Modifier value with color dot */
.mod-value-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-left: 20rpx;
}

.mod-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.mod-dot.positive {
  background: var(--success);
}

.mod-dot.negative {
  background: var(--danger);
}

.mod-dot.neutral {
  background: #9ca3af;
}

/* Disclaimer */
.disclaimer {
  margin-top: 24rpx;
  padding: 24rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
  line-height: 1.7;
  background: var(--bg);
  border-radius: var(--radius);
}

.disclaimer-title {
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 10rpx;
  font-size: 24rpx;
}

/* Action Buttons */
.action-row {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.btn-secondary {
  flex: 1;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  background: var(--card-bg);
  color: var(--text);
  border-radius: var(--radius);
  font-size: 30rpx;
  font-weight: 600;
  border: 2rpx solid var(--border);
  transition: all 0.15s ease;
}

.btn-secondary:active {
  transform: scale(0.97);
}

.btn-secondary.primary {
  background: var(--primary-gradient);
  color: #fff;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(44, 150, 120, 0.3);
}

/* Back to Top Button */
.back-top {
  position: fixed;
  right: 32rpx;
  bottom: 140rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: var(--shadow-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transform: translateY(20rpx);
  transition: opacity 0.25s ease, transform 0.25s ease;
  pointer-events: none;
  z-index: 100;
  border: 1rpx solid var(--border-light);
}

.back-top.visible {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.back-top:active {
  transform: scale(0.9) !important;
}

.back-top-icon {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary);
  line-height: 1;
}

.back-top-text {
  font-size: 18rpx;
  color: var(--text-secondary);
  margin-top: 2rpx;
}

.safe-bottom {
  height: 40rpx;
}
