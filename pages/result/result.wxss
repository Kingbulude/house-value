.result-header {
  text-align: center;
  padding: 30rpx 0 10rpx;
}

.result-community {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 16rpx;
}

.result-meta {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

/* Highlight Card */
.highlight {
  text-align: center;
  padding: 50rpx 30rpx 30rpx;
}

.highlight-label {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.highlight-price {
  font-size: 72rpx;
  font-weight: 700;
  color: var(--primary);
  line-height: 1.2;
}

.highlight-unit {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.highlight-range {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 10rpx;
}

/* Highlight Actions */
.highlight-actions {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}

.hl-action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  background: rgba(0, 0, 0, 0.04);
  transition: background 0.2s;
}

.hl-action-btn:active {
  background: rgba(0, 0, 0, 0.08);
}

.hl-action-icon {
  font-size: 28rpx;
}

.hl-action-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

/* Confidence Badge */
.confidence-badge {
  display: inline-block;
  margin-top: 16rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.confidence-high {
  background: rgba(5, 150, 105, 0.1);
  color: #059669;
}

.confidence-medium {
  background: rgba(217, 119, 6, 0.1);
  color: #d97706;
}

.confidence-low {
  background: rgba(220, 38, 38, 0.1);
  color: #dc2626;
}

/* Tab Bar */
.tab-bar {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.tab-item {
  display: inline-block;
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  border-bottom: 4rpx solid transparent;
  transition: all 0.2s;
}

.tab-item.active {
  color: var(--primary);
  border-bottom-color: var(--primary);
  font-weight: 600;
}

/* Tab Panel */
.tab-panel {
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* Info Rows */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  color: var(--text-secondary);
  flex-shrink: 0;
}

.info-value {
  color: var(--text);
  text-align: right;
  margin-left: 20rpx;
}

.info-value.negative {
  color: #dc2626;
}

.info-value.positive {
  color: #059669;
}

.info-value.neutral {
  color: var(--text);
}

.info-label.bold,
.info-value.bold {
  font-weight: 600;
  font-size: 30rpx;
}

/* Summary tab action link */
.summary-action {
  text-align: center;
  padding: 20rpx 0 8rpx;
  color: var(--primary);
  font-size: 26rpx;
  font-weight: 500;
}

/* Method Cards */
.method-card {
  background: #f8fafb;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.method-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.method-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary);
  margin: 8rpx 0;
}

.method-weight {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.method-notes {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #f8fafb;
  border-radius: 12rpx;
}

.note-item {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.8;
  margin-bottom: 8rpx;
}

.note-bold {
  font-weight: 600;
  color: var(--text);
}

/* Weight comparison bar */
.weight-bar {
  display: flex;
  height: 28rpx;
  border-radius: 14rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.weight-segment {
  display: flex;
  align-items: center;
  justify-content: center;
  transition: flex 0.3s ease;
  min-width: 0;
  overflow: hidden;
}

.weight-segment:empty,
.weight-segment[style*="flex:0"],
.weight-segment[style*="flex: 0"] {
  display: none;
}

.weight-seg-text {
  font-size: 20rpx;
  font-weight: 600;
  color: #fff;
  white-space: nowrap;
}

.weight-market {
  background: #3b82f6;
}

.weight-income {
  background: #10b981;
}

.weight-cost {
  background: #f59e0b;
}

.weight-legend {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
}

.dot-market { background: #3b82f6; }
.dot-income { background: #10b981; }
.dot-cost { background: #f59e0b; }

/* Amenities */
.amenity-dim {
  margin-bottom: 24rpx;
}

.amenity-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.amenity-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text);
}

.amenity-score {
  font-size: 28rpx;
  font-weight: 600;
}

.score-bar {
  height: 16rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
}

.score-bar-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.amenity-detail {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  line-height: 1.6;
}

.amenity-total {
  border-top: 1rpx solid var(--border);
  padding-top: 16rpx;
  margin-top: 8rpx;
}

.amenity-total-row {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  font-weight: 600;
}

.amenity-total-label {
  color: var(--text);
}

.amenity-total-value {
  color: var(--primary);
}

.amenity-note {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

/* Defects */
.defects-severity-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.severity-badge {
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.severe-badge {
  background: rgba(220, 38, 38, 0.1);
  color: #dc2626;
}

.moderate-badge {
  background: rgba(217, 119, 6, 0.1);
  color: #d97706;
}

.penalty-badge {
  background: rgba(107, 114, 128, 0.1);
  color: #6b7280;
}

.defects-clean {
  text-align: center;
  padding: 40rpx 0;
  color: #059669;
  font-size: 30rpx;
}

.defect-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.defect-item:last-child {
  border-bottom: none;
}

.defect-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.defect-icon.severe {
  background: #dc2626;
}

.defect-icon.warning {
  background: #d97706;
}

.defect-content {
  flex: 1;
}

.defect-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text);
}

.defect-penalty {
  color: #dc2626;
  font-size: 24rpx;
  font-weight: 600;
}

.defect-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
  line-height: 1.5;
}

.defects-summary {
  border-top: 1rpx solid var(--border);
  margin-top: 12rpx;
  padding-top: 12rpx;
}

/* Holding Cost */
.hc-highlight {
  background: #f0f9ff;
  border: 1rpx solid #bae6fd;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.hc-highlight-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0c4a6e;
  margin-bottom: 8rpx;
}

.hc-highlight-body {
  color: #075985;
  font-size: 28rpx;
  line-height: 1.6;
}

.hc-highlight-value {
  font-weight: 700;
  color: var(--primary);
}

.hc-highlight-note {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 4rpx;
}

/* Holding cost visual breakdown */
.hc-breakdown {
  margin-bottom: 24rpx;
}

.hc-breakdown-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 12rpx;
}

.hc-bar-track {
  display: flex;
  height: 20rpx;
  border-radius: 10rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.hc-bar-segment {
  transition: flex 0.3s ease;
  min-width: 4rpx;
}

.hc-breakdown-legend {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.hc-legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
}

.hc-legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}

.hc-legend-name {
  color: var(--text-secondary);
  flex: 1;
}

.hc-legend-val {
  color: var(--text);
  font-weight: 500;
}

.hc-divider {
  border-top: 1rpx solid var(--border);
  margin: 16rpx 0;
}

.hc-notes {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.8;
}

/* Factors */
.factor-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 8rpx;
  margin-top: 8rpx;
}

.factor-divider {
  border-top: 1rpx solid var(--border);
  margin: 16rpx 0;
}

.factor-total {
  border-top: 2rpx solid var(--border);
  padding-top: 16rpx;
  margin-top: 8rpx;
}

/* Modifier value with color dot */
.mod-value-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-left: 20rpx;
}

.mod-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.mod-dot.positive {
  background: #059669;
}

.mod-dot.negative {
  background: #dc2626;
}

.mod-dot.neutral {
  background: #9ca3af;
}

/* Disclaimer */
.disclaimer {
  margin-top: 20rpx;
  padding: 20rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  background: #fafafa;
  border-radius: 12rpx;
}

.disclaimer-title {
  font-weight: 600;
  color: var(--text);
  margin-bottom: 8rpx;
  font-size: 24rpx;
}

/* Action Buttons */
.action-row {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.btn-secondary {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #fff;
  color: var(--text);
  border-radius: 12rpx;
  font-size: 30rpx;
  border: 1rpx solid var(--border);
}

.btn-secondary.primary {
  background: var(--primary);
  color: #fff;
  border: none;
}

/* Back to Top Button */
.back-top {
  position: fixed;
  right: 32rpx;
  bottom: 120rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.12);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transform: translateY(20rpx);
  transition: opacity 0.25s ease, transform 0.25s ease;
  pointer-events: none;
  z-index: 100;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
}

.back-top.visible {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.back-top:active {
  transform: scale(0.92);
}

.back-top-icon {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1;
}

.back-top-text {
  font-size: 18rpx;
  color: var(--text-secondary);
  margin-top: 2rpx;
}

.safe-bottom {
  height: 40rpx;
}
